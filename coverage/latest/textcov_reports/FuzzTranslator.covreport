 5857|    338|        var prefix: (position: MetaProgramCounter, producer: AccProducerForm)?
 5858|    338|        var accCompare: AccCompare?
 5859|    338|        if let candidate, candidate.result == value, iseqBuilder.canRewind(to: candidate) {
 5860|     10|            fusable = (.negated(candidate.condition), result, candidate.position)
 5861|     10|            prefix = candidate.prefix.map { (candidate.position, $0) }
 5862|     10|            accCompare = candidate.accCompare
 5863|     10|            accCompare?.negated.toggle()
 5864|     10|        }
 5865|    338|        emit(
 5866|    338|            .i64Eqz(Instruction.UnaryOperand(result: LVReg(result), input: LVReg(value))),
 5867|    338|            resultRelink: { newResult in
 5868|    338|                .i64Eqz(Instruction.UnaryOperand(result: LVReg(newResult), input: LVReg(value)))
 5869|    338|            },
 5870|    338|            fusable: fusable
 5871|    338|        )
 5872|    338|        if prefix != nil || accCompare != nil {
 5873|     10|            iseqBuilder.recordAcc(AccRecords(compare: accCompare, prefix: prefix))
 5874|     10|        }
 5875|    338|    }
