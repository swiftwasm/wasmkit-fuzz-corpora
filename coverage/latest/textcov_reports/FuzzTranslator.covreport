$s7WasmKit19SystemVirtualMemoryV7reserve012_4B8B6EC3485G19F901B0F527435CECAB8LLySvSgSiFZ:
   69|  1.50k|        private static func reserve(_ reservationBytes: Int) -> UnsafeMutableRawPointer? {
   70|       |            #if os(WASI)
   71|       |                // WASI has no reserve-without-commit primitive
   72|       |                return nil
   73|       |            #elseif os(Windows)
   74|       |                return VirtualAlloc(nil, SIZE_T(reservationBytes), DWORD(MEM_RESERVE), DWORD(PAGE_NOACCESS))
   75|       |            #else
   76|       |                #if os(Linux)
   77|  1.50k|                    let mapAnon = MAP_ANONYMOUS
   78|  1.50k|                    let mapNoReserve = MAP_NORESERVE
   79|       |                #else
   80|       |                    let mapAnon = MAP_ANON
   81|       |                    // Darwin and the BSDs have no `MAP_NORESERVE`; they do not
   82|       |                    // charge commit for untouched anonymous pages either.
   83|       |                    let mapNoReserve: Int32 = 0
   84|       |                #endif
   85|  1.50k|                // `MAP_NORESERVE` so a large reservation is not charged against
   86|  1.50k|                // commit/swap up front; pages are backed on first access. Without
   87|  1.50k|                // it a big reservation is refused outright under strict overcommit
   88|  1.50k|                // (`vm.overcommit_memory=2`).
   89|  1.50k|                let base = mmap(nil, reservationBytes, PROT_NONE, MAP_PRIVATE | mapAnon | mapNoReserve, -1, 0)
   90|  1.50k|                // `MAP_FAILED` is `(void *)-1`; compare that sentinel directly rather than the
   91|  1.50k|                // macro, which Bionic defines as a C++ `reinterpret_cast` Swift cannot import.
   92|  1.50k|                guard base != UnsafeMutableRawPointer(bitPattern: -1) else { return nil }
   93|  1.50k|                return base
   94|       |            #endif
   95|  1.50k|        }
$s7WasmKit19SystemVirtualMemoryV6commit012_4B8B6EC3485G19F901B0F527435CECAB8LL_6offset9byteCountSbSv_S2itFZ:
   97|  1.21k|        private static func commit(_ base: UnsafeMutableRawPointer, offset: Int, byteCount: Int) -> Bool {
   98|       |            #if os(WASI)
   99|       |                // WASI does not support commit-without-reserve; use a full allocation instead
  100|       |                return false
  101|       |            #elseif os(Windows)
  102|       |                return VirtualAlloc(
  103|       |                    base.advanced(by: offset), SIZE_T(byteCount),
  104|       |                    DWORD(MEM_COMMIT), DWORD(PAGE_READWRITE)
  105|       |                ) != nil
  106|       |            #else
  107|  1.21k|                return mprotect(base.advanced(by: offset), byteCount, PROT_READ | PROT_WRITE) == 0
  108|       |            #endif
  109|  1.21k|        }
$s7WasmKit19SystemVirtualMemoryV7release012_4B8B6EC3485G19F901B0F527435CECAB8LL_16reservationBytesySv_SitFZ:
  111|  1.50k|        private static func release(_ base: UnsafeMutableRawPointer, reservationBytes: Int) {
  112|  1.50k|            guard reservationBytes > 0 else {
  113|      0|                base.deallocate()
  114|      0|                return
  115|  1.50k|            }
  116|       |            #if os(WASI)
  117|       |                // Unsupported; WASI has no reserve-without-commit primitive, so this type is never used there.
  118|       |            #elseif os(Windows)
  119|       |                VirtualFree(base, 0, DWORD(MEM_RELEASE))
  120|       |            #else
  121|  1.50k|                munmap(base, reservationBytes)
  122|       |            #endif
  123|  1.50k|        }

