 5942|    461|    mutating func visitI64Eqz() throws(WasmKitError) -> Output {
 5943|    461|        // Captured before `popVRegOperand`, which resets the last emission.
 5944|    461|        let candidate = iseqBuilder.fusableEmission
 5945|    461|        let value = try popVRegOperand(.i64)
 5946|    449|        let result = valueStack.push(.i32)
 5947|    449|        guard let value = value else { return }
 5948|    344|        // An `i64.eqz` of a 64-bit `and` the previous instruction just computed is
 5949|    344|        // that bit test negated, so a following branch can replace both.
 5950|    344|        var fusable: (condition: FusableCondition, result: VReg, start: MetaProgramCounter?)?
 5951|    344|        var prefix: (position: MetaProgramCounter, producer: AccProducerForm)?
 5952|    344|        var accCompare: AccCompare?
 5953|    344|        if let candidate, candidate.result == value, iseqBuilder.canRewind(to: candidate) {
 5954|     10|            fusable = (.negated(candidate.condition), result, candidate.position)
 5955|     10|            prefix = candidate.prefix.map { (candidate.position, $0) }
 5956|     10|            accCompare = candidate.accCompare
 5957|     10|            accCompare?.negated.toggle()
 5958|     10|        }
 5959|    344|        emit(
 5960|    344|            .i64Eqz(Instruction.UnaryOperand(result: LVReg(result), input: LVReg(value))),
 5961|    344|            resultRelink: { newResult in
 5962|    344|                .i64Eqz(Instruction.UnaryOperand(result: LVReg(newResult), input: LVReg(value)))
 5963|    344|            },
 5964|    344|            fusable: fusable
 5965|    344|        )
 5966|    344|        if prefix != nil || accCompare != nil {
 5967|     10|            iseqBuilder.recordAcc(AccRecords(compare: accCompare, prefix: prefix))
 5968|     10|        }
 5969|    344|    }
