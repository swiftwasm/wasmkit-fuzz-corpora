 6071|    484|    mutating func visitI64Eqz() throws(WasmKitError) -> Output {
 6072|    484|        // Captured before `popVRegOperand`, which resets the last emission.
 6073|    484|        let candidate = iseqBuilder.fusableEmission
 6074|    484|        let value = try popVRegOperand(.i64)
 6075|    473|        let result = valueStack.push(.i32)
 6076|    473|        guard let value = value else { return }
 6077|    366|        // An `i64.eqz` of a 64-bit `and` the previous instruction just computed is
 6078|    366|        // that bit test negated, so a following branch can replace both.
 6079|    366|        var fusable: (condition: FusableCondition, result: VReg, start: MetaProgramCounter?)?
 6080|    366|        var prefix: (position: MetaProgramCounter, producer: AccProducerForm)?
 6081|    366|        var accCompare: AccCompare?
 6082|    366|        if let candidate, candidate.result == value, iseqBuilder.canRewind(to: candidate) {
 6083|     10|            fusable = (.negated(candidate.condition), result, candidate.position)
 6084|     10|            prefix = candidate.prefix.map { (candidate.position, $0) }
 6085|     10|            accCompare = candidate.accCompare
 6086|     10|            accCompare?.negated.toggle()
 6087|     10|        }
 6088|    366|        emit(
 6089|    366|            .i64Eqz(Instruction.UnaryOperand(result: LVReg(result), input: LVReg(value))),
 6090|    366|            resultRelink: { newResult in
 6091|    366|                .i64Eqz(Instruction.UnaryOperand(result: LVReg(newResult), input: LVReg(value)))
 6092|    366|            },
 6093|    366|            fusable: fusable
 6094|    366|        )
 6095|    366|        if prefix != nil || accCompare != nil {
 6096|     10|            iseqBuilder.recordAcc(AccRecords(compare: accCompare, prefix: prefix))
 6097|     10|        }
 6098|    366|    }
