   85|  1.51k|                // `MAP_NORESERVE` so a large reservation is not charged against
   86|  1.51k|                // commit/swap up front; pages are backed on first access. Without
   87|  1.51k|                // it a big reservation is refused outright under strict overcommit
   88|  1.51k|                // (`vm.overcommit_memory=2`).
   89|  1.51k|                let base = mmap(nil, reservationBytes, PROT_NONE, MAP_PRIVATE | mapAnon | mapNoReserve, -1, 0)
