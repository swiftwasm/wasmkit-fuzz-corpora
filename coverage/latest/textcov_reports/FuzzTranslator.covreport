$s9WasmTypes4V128V11descriptionSSvg:
   60|     13|    public var description: String {
   61|     13|        // Build the hex string in a single byte buffer to avoid per-byte
   62|     13|        // string allocations.
   63|     13|        var utf8: [UInt8] = []
   64|     13|        utf8.reserveCapacity(2 + bytes.count * 2)
   65|     13|        utf8.append(UInt8(ascii: "0"))
   66|     13|        utf8.append(UInt8(ascii: "x"))
   67|    208|        for byte in bytes {
   68|    208|            utf8.append(hexDigits.utf8Start[Int(byte >> 4)])
   69|    208|            utf8.append(hexDigits.utf8Start[Int(byte & 0xF)])
   70|    208|        }
   71|     13|        return String(decoding: utf8, as: UTF8.self)
   72|     13|    }
