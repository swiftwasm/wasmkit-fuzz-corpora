 5962|    470|        guard let value = value else { return }
 5963|    363|        // An `i64.eqz` of a 64-bit `and` the previous instruction just computed is
 5964|    363|        // that bit test negated, so a following branch can replace both.
 5965|    363|        var fusable: (condition: FusableCondition, result: VReg, start: MetaProgramCounter?)?
 5966|    363|        var prefix: (position: MetaProgramCounter, producer: AccProducerForm)?
 5967|    363|        var accCompare: AccCompare?
 5968|    363|        if let candidate, candidate.result == value, iseqBuilder.canRewind(to: candidate) {
 5969|     10|            fusable = (.negated(candidate.condition), result, candidate.position)
 5970|     10|            prefix = candidate.prefix.map { (candidate.position, $0) }
 5971|     10|            accCompare = candidate.accCompare
 5972|     10|            accCompare?.negated.toggle()
 5973|     10|        }
 5974|    363|        emit(
 5975|    363|            .i64Eqz(Instruction.UnaryOperand(result: LVReg(result), input: LVReg(value))),
 5976|    363|            resultRelink: { newResult in
 5977|    363|                .i64Eqz(Instruction.UnaryOperand(result: LVReg(newResult), input: LVReg(value)))
 5978|    363|            },
 5979|    363|            fusable: fusable
 5980|    363|        )
 5981|    363|        if prefix != nil || accCompare != nil {
 5982|     10|            iseqBuilder.recordAcc(AccRecords(compare: accCompare, prefix: prefix))
 5983|     10|        }
 5984|    363|    }
