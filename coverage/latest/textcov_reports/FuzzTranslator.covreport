   69|  1.46k|        private static func reserve(_ reservationBytes: Int) -> UnsafeMutableRawPointer? {
   70|       |            #if os(WASI)
   71|       |                // WASI has no reserve-without-commit primitive
   72|       |                return nil
   73|       |            #elseif os(Windows)
