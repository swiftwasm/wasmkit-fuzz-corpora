 5643|  20.3k|            .i32Eqz(Instruction.UnaryOperand(result: LVReg(result), input: LVReg(value))),
 5644|  20.3k|            resultRelink: { newResult in
 5645|  20.3k|                .i32Eqz(Instruction.UnaryOperand(result: LVReg(newResult), input: LVReg(value)))
 5646|  20.3k|            },
 5647|  20.3k|            fusable: fusable
 5648|  20.3k|        )
 5649|  20.3k|        if prefix != nil || accCompare != nil {
