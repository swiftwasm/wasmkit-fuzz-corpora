 1488|   128k|        case .call(let immediate): immediate.emit(to: emit)
 1489|   128k|        case .compilingCall(let immediate): immediate.emit(to: emit)
 1490|   128k|        case .internalCall(let immediate): immediate.emit(to: emit)
 1491|   128k|        case .callIndirect(let immediate): immediate.emit(to: emit)
 1492|   128k|        case .resizeFrameHeader(let immediate): immediate.emit(to: emit)
 1493|   128k|        case .returnCall(let immediate): immediate.emit(to: emit)
 1494|   128k|        case .returnCallIndirect(let immediate): immediate.emit(to: emit)
 1495|   128k|        case .br(let immediate): immediate.emit(to: emit)
 1496|   128k|        case .brIf(let immediate): immediate.emit(to: emit)
 1497|   128k|        case .brIfNot(let immediate): immediate.emit(to: emit)
 1498|   128k|        case .brTable(let immediate): immediate.emit(to: emit)
