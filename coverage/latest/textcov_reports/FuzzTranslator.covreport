 5221|    521|    mutating func visitI64Eqz() throws(WasmKitError) -> Output {
 5222|    521|        // Captured before `popVRegOperand`, which resets the last emission.
 5223|    521|        let candidate = iseqBuilder.fusableEmission
 5224|    521|        let value = try popVRegOperand(.i64)
 5225|    510|        let result = valueStack.push(.i32)
 5226|    510|        guard let value = value else { return }
 5227|    397|        // An `i64.eqz` of a 64-bit `and` the previous instruction just computed is
 5228|    397|        // that bit test negated, so a following branch can replace both.
 5229|    397|        var fusable: (condition: FusableCondition, result: VReg, start: MetaProgramCounter?)?
 5230|    397|        var prefix: (position: MetaProgramCounter, producer: AccProducerForm)?
 5231|    397|        var accCompare: AccCompare?
 5232|    397|        if let candidate, candidate.result == value, iseqBuilder.canRewind(to: candidate) {
 5233|      6|            fusable = (.negated(candidate.condition), result, candidate.position)
 5234|      6|            prefix = candidate.prefix.map { (candidate.position, $0) }
 5235|      6|            accCompare = candidate.accCompare
 5236|      6|            accCompare?.negated.toggle()
 5237|      6|        }
 5238|    397|        emit(
 5239|    397|            .i64Eqz(Instruction.UnaryOperand(result: LVReg(result), input: LVReg(value))),
 5240|    397|            resultRelink: { newResult in
 5241|    397|                .i64Eqz(Instruction.UnaryOperand(result: LVReg(newResult), input: LVReg(value)))
 5242|    397|            },
 5243|    397|            fusable: fusable
 5244|    397|        )
 5245|    397|        if prefix != nil || accCompare != nil {
 5246|      0|            iseqBuilder.recordAcc(AccRecords(compare: accCompare, prefix: prefix))
 5247|      0|        }
 5248|    397|    }
