 6294|  52.5k|    public mutating func visitBinary(_ binary: WasmParser.Instruction.Binary) throws(WasmKitError) {
 6295|  52.5k|        // Operations with a superinstruction form go through
 6296|  52.5k|        // `visitFusableBinary`, which folds adjacent pairs.
 6297|  52.5k|        switch binary {
 6298|  52.5k|        case .f32Add: return try visitFusableBinary(.f32, .add)
 6299|  52.5k|        case .f32Sub: return try visitFusableBinary(.f32, .sub)
 6300|  52.5k|        case .f32Mul: return try visitFusableBinary(.f32, .mul)
 6301|  52.5k|        case .f32Div: return try visitFusableBinary(.f32, .div)
 6302|  52.5k|        case .f64Add: return try visitFusableBinary(.f64, .add)
 6303|  52.5k|        case .f64Sub: return try visitFusableBinary(.f64, .sub)
 6304|  52.5k|        case .f64Mul: return try visitFusableBinary(.f64, .mul)
 6305|  52.5k|        case .f64Div: return try visitFusableBinary(.f64, .div)
 6306|  52.5k|        case .i32Add: return try visitFusableBinary(.i32, .add)
 6307|  52.5k|        case .i32Sub: return try visitFusableBinary(.i32, .sub)
 6308|  52.5k|        case .i32Mul: return try visitFusableBinary(.i32, .mul)
 6309|  52.5k|        case .i32And: return try visitFusableBinary(.i32, .and)
 6310|  52.5k|        case .i32Or: return try visitFusableBinary(.i32, .or)
 6311|  52.5k|        case .i32Xor: return try visitFusableBinary(.i32, .xor)
 6312|  52.5k|        case .i32Shl: return try visitFusableBinary(.i32, .shl)
 6313|  52.5k|        case .i32ShrS: return try visitFusableBinary(.i32, .shrS)
 6314|  52.5k|        case .i32ShrU: return try visitFusableBinary(.i32, .shrU)
 6315|  52.5k|        case .i32Rotl: return try visitFusableBinary(.i32, .rotl)
 6316|  52.5k|        case .i32Rotr: return try visitFusableBinary(.i32, .rotr)
 6317|  52.5k|        case .i64Add: return try visitFusableBinary(.i64, .add)
