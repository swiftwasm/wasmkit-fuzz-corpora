  111|  1.51k|        private static func release(_ base: UnsafeMutableRawPointer, reservationBytes: Int) {
  112|  1.51k|            guard reservationBytes > 0 else {
  113|      0|                base.deallocate()
  114|      0|                return
  115|  1.51k|            }
  116|       |            #if os(WASI)
  117|       |                // Unsupported; WASI has no reserve-without-commit primitive, so this type is never used there.
  118|       |            #elseif os(Windows)
  119|       |                VirtualFree(base, 0, DWORD(MEM_RELEASE))
  120|       |            #else
  121|  1.51k|                munmap(base, reservationBytes)
  122|       |            #endif
  123|  1.51k|        }

