   69|  1.66k|        private static func reserve(_ reservationBytes: Int) -> UnsafeMutableRawPointer? {
   70|       |            #if os(WASI)
   71|       |                // WASI has no reserve-without-commit primitive
   72|       |                return nil
   73|       |            #elseif os(Windows)
   74|       |                return VirtualAlloc(nil, SIZE_T(reservationBytes), DWORD(MEM_RESERVE), DWORD(PAGE_NOACCESS))
   75|       |            #else
   76|       |                #if os(Linux)
   77|  1.66k|                    let mapAnon = MAP_ANONYMOUS
   78|  1.66k|                    let mapNoReserve = MAP_NORESERVE
   79|       |                #else
   80|       |                    let mapAnon = MAP_ANON
   81|       |                    // Darwin and the BSDs have no `MAP_NORESERVE`; they do not
   82|       |                    // charge commit for untouched anonymous pages either.
   83|       |                    let mapNoReserve: Int32 = 0
   84|       |                #endif
   85|  1.66k|                // `MAP_NORESERVE` so a large reservation is not charged against
   86|  1.66k|                // commit/swap up front; pages are backed on first access. Without
   87|  1.66k|                // it a big reservation is refused outright under strict overcommit
   88|  1.66k|                // (`vm.overcommit_memory=2`).
   89|  1.66k|                let base = mmap(nil, reservationBytes, PROT_NONE, MAP_PRIVATE | mapAnon | mapNoReserve, -1, 0)
   90|  1.66k|                // `MAP_FAILED` is `(void *)-1`; compare that sentinel directly rather than the
   91|  1.66k|                // macro, which Bionic defines as a C++ `reinterpret_cast` Swift cannot import.
   92|  1.66k|                guard base != UnsafeMutableRawPointer(bitPattern: -1) else { return nil }
   93|  1.66k|                return base
   94|       |            #endif
   95|  1.66k|        }
