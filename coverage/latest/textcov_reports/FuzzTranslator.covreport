 6071|    497|    mutating func visitI64Eqz() throws(WasmKitError) -> Output {
 6072|    497|        // Captured before `popVRegOperand`, which resets the last emission.
 6073|    497|        let candidate = iseqBuilder.fusableEmission
 6074|    497|        let value = try popVRegOperand(.i64)
 6075|    486|        let result = valueStack.push(.i32)
 6076|    486|        guard let value = value else { return }
 6077|    379|        // An `i64.eqz` of a 64-bit `and` the previous instruction just computed is
 6078|    379|        // that bit test negated, so a following branch can replace both.
 6079|    379|        var fusable: (condition: FusableCondition, result: VReg, start: MetaProgramCounter?)?
 6080|    379|        var prefix: (position: MetaProgramCounter, producer: AccProducerForm)?
 6081|    379|        var accCompare: AccCompare?
 6082|    379|        if let candidate, candidate.result == value, iseqBuilder.canRewind(to: candidate) {
 6083|     10|            fusable = (.negated(candidate.condition), result, candidate.position)
 6084|     10|            prefix = candidate.prefix.map { (candidate.position, $0) }
 6085|     10|            accCompare = candidate.accCompare
 6086|     10|            accCompare?.negated.toggle()
 6087|     10|        }
 6088|    379|        emit(
 6089|    379|            .i64Eqz(Instruction.UnaryOperand(result: LVReg(result), input: LVReg(value))),
 6090|    379|            resultRelink: { newResult in
 6091|    379|                .i64Eqz(Instruction.UnaryOperand(result: LVReg(newResult), input: LVReg(value)))
 6092|    379|            },
 6093|    379|            fusable: fusable
 6094|    379|        )
 6095|    379|        if prefix != nil || accCompare != nil {
 6096|     10|            iseqBuilder.recordAcc(AccRecords(compare: accCompare, prefix: prefix))
 6097|     10|        }
 6098|    379|    }
