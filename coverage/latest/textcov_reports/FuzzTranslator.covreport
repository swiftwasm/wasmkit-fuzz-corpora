  111|  1.44k|        private static func release(_ base: UnsafeMutableRawPointer, reservationBytes: Int) {
  112|  1.44k|            guard reservationBytes > 0 else {
  113|      0|                base.deallocate()
  114|      0|                return
  115|  1.44k|            }
  116|       |            #if os(WASI)
