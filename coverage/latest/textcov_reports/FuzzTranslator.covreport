 5700|    479|        // Captured before `popVRegOperand`, which resets the last emission.
 5701|    479|        let candidate = iseqBuilder.fusableEmission
 5702|    479|        let value = try popVRegOperand(.i64)
 5703|    465|        let result = valueStack.push(.i32)
 5704|    465|        guard let value = value else { return }
 5705|    358|        // An `i64.eqz` of a 64-bit `and` the previous instruction just computed is
 5706|    358|        // that bit test negated, so a following branch can replace both.
 5707|    358|        var fusable: (condition: FusableCondition, result: VReg, start: MetaProgramCounter?)?
 5708|    358|        var prefix: (position: MetaProgramCounter, producer: AccProducerForm)?
 5709|    358|        var accCompare: AccCompare?
 5710|    358|        if let candidate, candidate.result == value, iseqBuilder.canRewind(to: candidate) {
 5711|      6|            fusable = (.negated(candidate.condition), result, candidate.position)
 5712|      6|            prefix = candidate.prefix.map { (candidate.position, $0) }
 5713|      6|            accCompare = candidate.accCompare
 5714|      6|            accCompare?.negated.toggle()
 5715|      6|        }
 5716|    358|        emit(
 5717|    358|            .i64Eqz(Instruction.UnaryOperand(result: LVReg(result), input: LVReg(value))),
 5718|    358|            resultRelink: { newResult in
 5719|    358|                .i64Eqz(Instruction.UnaryOperand(result: LVReg(newResult), input: LVReg(value)))
 5720|    358|            },
 5721|    358|            fusable: fusable
 5722|    358|        )
 5723|    358|        if prefix != nil || accCompare != nil {
 5724|      3|            iseqBuilder.recordAcc(AccRecords(compare: accCompare, prefix: prefix))
 5725|      3|        }
 5726|    358|    }
