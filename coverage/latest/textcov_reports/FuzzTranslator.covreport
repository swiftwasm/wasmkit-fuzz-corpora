 5408|    360|            .i64Eqz(Instruction.UnaryOperand(result: LVReg(result), input: LVReg(value))),
 5409|    360|            resultRelink: { newResult in
 5410|    360|                .i64Eqz(Instruction.UnaryOperand(result: LVReg(newResult), input: LVReg(value)))
 5411|    360|            },
 5412|    360|            fusable: fusable
 5413|    360|        )
