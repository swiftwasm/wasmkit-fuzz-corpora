 5789|    468|    mutating func visitI64Eqz() throws(WasmKitError) -> Output {
 5790|    468|        // Captured before `popVRegOperand`, which resets the last emission.
 5791|    468|        let candidate = iseqBuilder.fusableEmission
 5792|    468|        let value = try popVRegOperand(.i64)
 5793|    454|        let result = valueStack.push(.i32)
 5794|    454|        guard let value = value else { return }
 5795|    348|        // An `i64.eqz` of a 64-bit `and` the previous instruction just computed is
 5796|    348|        // that bit test negated, so a following branch can replace both.
 5797|    348|        var fusable: (condition: FusableCondition, result: VReg, start: MetaProgramCounter?)?
 5798|    348|        var prefix: (position: MetaProgramCounter, producer: AccProducerForm)?
 5799|    348|        var accCompare: AccCompare?
 5800|    348|        if let candidate, candidate.result == value, iseqBuilder.canRewind(to: candidate) {
 5801|     10|            fusable = (.negated(candidate.condition), result, candidate.position)
 5802|     10|            prefix = candidate.prefix.map { (candidate.position, $0) }
 5803|     10|            accCompare = candidate.accCompare
 5804|     10|            accCompare?.negated.toggle()
 5805|     10|        }
 5806|    348|        emit(
 5807|    348|            .i64Eqz(Instruction.UnaryOperand(result: LVReg(result), input: LVReg(value))),
 5808|    348|            resultRelink: { newResult in
 5809|    348|                .i64Eqz(Instruction.UnaryOperand(result: LVReg(newResult), input: LVReg(value)))
 5810|    348|            },
 5811|    348|            fusable: fusable
 5812|    348|        )
 5813|    348|        if prefix != nil || accCompare != nil {
 5814|     10|            iseqBuilder.recordAcc(AccRecords(compare: accCompare, prefix: prefix))
 5815|     10|        }
 5816|    348|    }
