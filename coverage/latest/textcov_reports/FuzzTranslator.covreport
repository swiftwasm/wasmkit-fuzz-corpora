  104|       |                    DWORD(MEM_COMMIT), DWORD(PAGE_READWRITE)
  105|       |                ) != nil
  106|       |            #else
  107|  1.22k|                return mprotect(base.advanced(by: offset), byteCount, PROT_READ | PROT_WRITE) == 0
  108|       |            #endif
  109|  1.22k|        }
