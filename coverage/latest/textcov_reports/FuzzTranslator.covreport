 3659|    405|    mutating func visitI64Eqz() throws(WasmKitError) -> Output {
 3660|    405|        // Captured before `popVRegOperand`, which resets the last emission.
 3661|    405|        let candidate = iseqBuilder.fusableEmission
 3662|    405|        let value = try popVRegOperand(.i64)
 3663|    398|        let result = valueStack.push(.i32)
 3664|    398|        guard let value = value else { return }
 3665|    293|        // An `i64.eqz` of a 64-bit `and` the previous instruction just computed is
 3666|    293|        // that bit test negated, so a following branch can replace both.
 3667|    293|        var fusable: (condition: FusableCondition, result: VReg, start: MetaProgramCounter?)?
 3668|    293|        if let candidate, candidate.result == value, iseqBuilder.canRewind(to: candidate) {
 3669|      0|            fusable = (.negated(candidate.condition), result, candidate.position)
 3670|      0|        }
 3671|    293|        emit(
 3672|    293|            .i64Eqz(Instruction.UnaryOperand(result: LVReg(result), input: LVReg(value))),
 3673|    293|            resultRelink: { newResult in
 3674|    293|                .i64Eqz(Instruction.UnaryOperand(result: LVReg(newResult), input: LVReg(value)))
 3675|    293|            },
 3676|    293|            fusable: fusable
 3677|    293|        )
 3678|    293|    }
