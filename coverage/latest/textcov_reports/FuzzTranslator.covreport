 6399|    404|            .i64Eqz(Instruction.UnaryOperand(result: LVReg(result), input: LVReg(value))),
 6400|    404|            resultRelink: { newResult in
 6401|    404|                .i64Eqz(Instruction.UnaryOperand(result: LVReg(newResult), input: LVReg(value)))
 6402|    404|            },
 6403|    404|            fusable: fusable
 6404|    404|        )
 6405|    404|        if prefix != nil || accCompare != nil {
 6406|     10|            iseqBuilder.recordAcc(AccRecords(compare: accCompare, prefix: prefix))
