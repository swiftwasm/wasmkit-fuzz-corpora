$s9WasmTypes4V128V11descriptionSSvg:
   78|     16|    public var description: String {
   79|     16|        // Build the hex string in a single byte buffer to avoid per-byte
   80|     16|        // string allocations.
   81|     16|        var utf8: [UInt8] = []
   82|     16|        utf8.reserveCapacity(2 + bytes.count * 2)
   83|     16|        utf8.append(UInt8(ascii: "0"))
   84|     16|        utf8.append(UInt8(ascii: "x"))
   85|    256|        for byte in bytes {
   86|    256|            utf8.append(hexDigits.utf8Start[Int(byte >> 4)])
   87|    256|            utf8.append(hexDigits.utf8Start[Int(byte & 0xF)])
   88|    256|        }
   89|     16|        return String(decoding: utf8, as: UTF8.self)
   90|     16|    }
