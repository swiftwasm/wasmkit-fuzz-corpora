 5250|      6|            fusable = (.negated(candidate.condition), result, candidate.position)
 5251|      6|            prefix = candidate.prefix.map { (candidate.position, $0) }
 5252|      6|            accCompare = candidate.accCompare
 5253|      6|            accCompare?.negated.toggle()
 5254|      6|        }
 5255|    384|        emit(
 5256|    384|            .i64Eqz(Instruction.UnaryOperand(result: LVReg(result), input: LVReg(value))),
 5257|    384|            resultRelink: { newResult in
 5258|    384|                .i64Eqz(Instruction.UnaryOperand(result: LVReg(newResult), input: LVReg(value)))
 5259|    384|            },
 5260|    384|            fusable: fusable
 5261|    384|        )
 5262|    384|        if prefix != nil || accCompare != nil {
 5263|      0|            iseqBuilder.recordAcc(AccRecords(compare: accCompare, prefix: prefix))
 5264|      0|        }
 5265|    384|    }
