 5827|    459|    mutating func visitI64Eqz() throws(WasmKitError) -> Output {
 5828|    459|        // Captured before `popVRegOperand`, which resets the last emission.
 5829|    459|        let candidate = iseqBuilder.fusableEmission
 5830|    459|        let value = try popVRegOperand(.i64)
 5831|    448|        let result = valueStack.push(.i32)
 5832|    448|        guard let value = value else { return }
 5833|    339|        // An `i64.eqz` of a 64-bit `and` the previous instruction just computed is
 5834|    339|        // that bit test negated, so a following branch can replace both.
 5835|    339|        var fusable: (condition: FusableCondition, result: VReg, start: MetaProgramCounter?)?
 5836|    339|        var prefix: (position: MetaProgramCounter, producer: AccProducerForm)?
 5837|    339|        var accCompare: AccCompare?
 5838|    339|        if let candidate, candidate.result == value, iseqBuilder.canRewind(to: candidate) {
 5839|     10|            fusable = (.negated(candidate.condition), result, candidate.position)
 5840|     10|            prefix = candidate.prefix.map { (candidate.position, $0) }
 5841|     10|            accCompare = candidate.accCompare
 5842|     10|            accCompare?.negated.toggle()
 5843|     10|        }
 5844|    339|        emit(
 5845|    339|            .i64Eqz(Instruction.UnaryOperand(result: LVReg(result), input: LVReg(value))),
 5846|    339|            resultRelink: { newResult in
 5847|    339|                .i64Eqz(Instruction.UnaryOperand(result: LVReg(newResult), input: LVReg(value)))
 5848|    339|            },
 5849|    339|            fusable: fusable
 5850|    339|        )
 5851|    339|        if prefix != nil || accCompare != nil {
 5852|     10|            iseqBuilder.recordAcc(AccRecords(compare: accCompare, prefix: prefix))
 5853|     10|        }
 5854|    339|    }
