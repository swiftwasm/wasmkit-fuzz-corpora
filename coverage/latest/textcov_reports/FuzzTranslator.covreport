   91|  1.40k|                // macro, which Bionic defines as a C++ `reinterpret_cast` Swift cannot import.
   92|  1.40k|                guard base != UnsafeMutableRawPointer(bitPattern: -1) else { return nil }
   93|  1.40k|                return base
   94|       |            #endif
   95|  1.40k|        }
