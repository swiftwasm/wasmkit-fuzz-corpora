$s9WasmTypes4V128V11descriptionSSvg:
   78|     13|    public var description: String {
   79|     13|        // Build the hex string in a single byte buffer to avoid per-byte
   80|     13|        // string allocations.
   81|     13|        var utf8: [UInt8] = []
   82|     13|        utf8.reserveCapacity(2 + bytes.count * 2)
   83|     13|        utf8.append(UInt8(ascii: "0"))
   84|     13|        utf8.append(UInt8(ascii: "x"))
   85|    208|        for byte in bytes {
   86|    208|            utf8.append(hexDigits.utf8Start[Int(byte >> 4)])
   87|    208|            utf8.append(hexDigits.utf8Start[Int(byte & 0xF)])
   88|    208|        }
   89|     13|        return String(decoding: utf8, as: UTF8.self)
   90|     13|    }
