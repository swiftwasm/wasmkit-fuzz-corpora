$s9WasmTypes4V128V11descriptionSSvg:
   78|     11|    public var description: String {
   79|     11|        // Build the hex string in a single byte buffer to avoid per-byte
   80|     11|        // string allocations.
   81|     11|        var utf8: [UInt8] = []
   82|     11|        utf8.reserveCapacity(2 + bytes.count * 2)
   83|     11|        utf8.append(UInt8(ascii: "0"))
   84|     11|        utf8.append(UInt8(ascii: "x"))
   85|    176|        for byte in bytes {
   86|    176|            utf8.append(hexDigits.utf8Start[Int(byte >> 4)])
   87|    176|            utf8.append(hexDigits.utf8Start[Int(byte & 0xF)])
   88|    176|        }
   89|     11|        return String(decoding: utf8, as: UTF8.self)
   90|     11|    }
