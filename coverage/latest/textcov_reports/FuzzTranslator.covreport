$s9WasmTypes4V128V11descriptionSSvg:
   78|     17|    public var description: String {
   79|     17|        // Build the hex string in a single byte buffer to avoid per-byte
   80|     17|        // string allocations.
   81|     17|        var utf8: [UInt8] = []
   82|     17|        utf8.reserveCapacity(2 + bytes.count * 2)
   83|     17|        utf8.append(UInt8(ascii: "0"))
   84|     17|        utf8.append(UInt8(ascii: "x"))
   85|    272|        for byte in bytes {
   86|    272|            utf8.append(hexDigits.utf8Start[Int(byte >> 4)])
   87|    272|            utf8.append(hexDigits.utf8Start[Int(byte & 0xF)])
   88|    272|        }
   89|     17|        return String(decoding: utf8, as: UTF8.self)
   90|     17|    }
