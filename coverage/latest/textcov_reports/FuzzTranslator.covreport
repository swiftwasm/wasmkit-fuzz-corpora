 5244|    384|        // An `i64.eqz` of a 64-bit `and` the previous instruction just computed is
 5245|    384|        // that bit test negated, so a following branch can replace both.
 5246|    384|        var fusable: (condition: FusableCondition, result: VReg, start: MetaProgramCounter?)?
 5247|    384|        var prefix: (position: MetaProgramCounter, producer: AccProducerForm)?
 5248|    384|        var accCompare: AccCompare?
