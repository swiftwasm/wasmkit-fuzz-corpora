$s9WasmTypes4V128V11descriptionSSvg:
   60|     11|    public var description: String {
   61|     11|        // Build the hex string in a single byte buffer to avoid per-byte
   62|     11|        // string allocations.
   63|     11|        var utf8: [UInt8] = []
   64|     11|        utf8.reserveCapacity(2 + bytes.count * 2)
   65|     11|        utf8.append(UInt8(ascii: "0"))
   66|     11|        utf8.append(UInt8(ascii: "x"))
   67|    176|        for byte in bytes {
   68|    176|            utf8.append(hexDigits.utf8Start[Int(byte >> 4)])
   69|    176|            utf8.append(hexDigits.utf8Start[Int(byte & 0xF)])
   70|    176|        }
   71|     11|        return String(decoding: utf8, as: UTF8.self)
   72|     11|    }
