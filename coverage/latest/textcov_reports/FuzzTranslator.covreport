 5702|    472|        let value = try popVRegOperand(.i64)
 5703|    458|        let result = valueStack.push(.i32)
 5704|    458|        guard let value = value else { return }
 5705|    353|        // An `i64.eqz` of a 64-bit `and` the previous instruction just computed is
 5706|    353|        // that bit test negated, so a following branch can replace both.
 5707|    353|        var fusable: (condition: FusableCondition, result: VReg, start: MetaProgramCounter?)?
 5708|    353|        var prefix: (position: MetaProgramCounter, producer: AccProducerForm)?
 5709|    353|        var accCompare: AccCompare?
