   82|       |                    // charge commit for untouched anonymous pages either.
   83|       |                    let mapNoReserve: Int32 = 0
   84|       |                #endif
   85|  1.46k|                // `MAP_NORESERVE` so a large reservation is not charged against
   86|  1.46k|                // commit/swap up front; pages are backed on first access. Without
   87|  1.46k|                // it a big reservation is refused outright under strict overcommit
   88|  1.46k|                // (`vm.overcommit_memory=2`).
   89|  1.46k|                let base = mmap(nil, reservationBytes, PROT_NONE, MAP_PRIVATE | mapAnon | mapNoReserve, -1, 0)
