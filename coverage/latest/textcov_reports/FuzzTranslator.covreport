 5827|    469|    mutating func visitI64Eqz() throws(WasmKitError) -> Output {
 5828|    469|        // Captured before `popVRegOperand`, which resets the last emission.
 5829|    469|        let candidate = iseqBuilder.fusableEmission
 5830|    469|        let value = try popVRegOperand(.i64)
 5831|    455|        let result = valueStack.push(.i32)
 5832|    455|        guard let value = value else { return }
 5833|    346|        // An `i64.eqz` of a 64-bit `and` the previous instruction just computed is
 5834|    346|        // that bit test negated, so a following branch can replace both.
 5835|    346|        var fusable: (condition: FusableCondition, result: VReg, start: MetaProgramCounter?)?
 5836|    346|        var prefix: (position: MetaProgramCounter, producer: AccProducerForm)?
 5837|    346|        var accCompare: AccCompare?
 5838|    346|        if let candidate, candidate.result == value, iseqBuilder.canRewind(to: candidate) {
 5839|     10|            fusable = (.negated(candidate.condition), result, candidate.position)
 5840|     10|            prefix = candidate.prefix.map { (candidate.position, $0) }
 5841|     10|            accCompare = candidate.accCompare
 5842|     10|            accCompare?.negated.toggle()
 5843|     10|        }
 5844|    346|        emit(
 5845|    346|            .i64Eqz(Instruction.UnaryOperand(result: LVReg(result), input: LVReg(value))),
 5846|    346|            resultRelink: { newResult in
 5847|    346|                .i64Eqz(Instruction.UnaryOperand(result: LVReg(newResult), input: LVReg(value)))
 5848|    346|            },
 5849|    346|            fusable: fusable
 5850|    346|        )
 5851|    346|        if prefix != nil || accCompare != nil {
 5852|     10|            iseqBuilder.recordAcc(AccRecords(compare: accCompare, prefix: prefix))
 5853|     10|        }
 5854|    346|    }
