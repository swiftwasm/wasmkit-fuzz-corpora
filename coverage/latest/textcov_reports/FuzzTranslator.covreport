 5711|      6|            fusable = (.negated(candidate.condition), result, candidate.position)
 5712|      6|            prefix = candidate.prefix.map { (candidate.position, $0) }
 5713|      6|            accCompare = candidate.accCompare
 5714|      6|            accCompare?.negated.toggle()
 5715|      6|        }
 5716|    353|        emit(
 5717|    353|            .i64Eqz(Instruction.UnaryOperand(result: LVReg(result), input: LVReg(value))),
 5718|    353|            resultRelink: { newResult in
 5719|    353|                .i64Eqz(Instruction.UnaryOperand(result: LVReg(newResult), input: LVReg(value)))
 5720|    353|            },
 5721|    353|            fusable: fusable
 5722|    353|        )
 5723|    353|        if prefix != nil || accCompare != nil {
 5724|      3|            iseqBuilder.recordAcc(AccRecords(compare: accCompare, prefix: prefix))
 5725|      3|        }
 5726|    353|    }
