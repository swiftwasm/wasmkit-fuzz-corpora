 5942|    462|    mutating func visitI64Eqz() throws(WasmKitError) -> Output {
 5943|    462|        // Captured before `popVRegOperand`, which resets the last emission.
 5944|    462|        let candidate = iseqBuilder.fusableEmission
 5945|    462|        let value = try popVRegOperand(.i64)
 5946|    449|        let result = valueStack.push(.i32)
 5947|    449|        guard let value = value else { return }
 5948|    345|        // An `i64.eqz` of a 64-bit `and` the previous instruction just computed is
 5949|    345|        // that bit test negated, so a following branch can replace both.
 5950|    345|        var fusable: (condition: FusableCondition, result: VReg, start: MetaProgramCounter?)?
 5951|    345|        var prefix: (position: MetaProgramCounter, producer: AccProducerForm)?
 5952|    345|        var accCompare: AccCompare?
 5953|    345|        if let candidate, candidate.result == value, iseqBuilder.canRewind(to: candidate) {
 5954|     10|            fusable = (.negated(candidate.condition), result, candidate.position)
 5955|     10|            prefix = candidate.prefix.map { (candidate.position, $0) }
 5956|     10|            accCompare = candidate.accCompare
 5957|     10|            accCompare?.negated.toggle()
 5958|     10|        }
 5959|    345|        emit(
 5960|    345|            .i64Eqz(Instruction.UnaryOperand(result: LVReg(result), input: LVReg(value))),
 5961|    345|            resultRelink: { newResult in
 5962|    345|                .i64Eqz(Instruction.UnaryOperand(result: LVReg(newResult), input: LVReg(value)))
 5963|    345|            },
 5964|    345|            fusable: fusable
 5965|    345|        )
 5966|    345|        if prefix != nil || accCompare != nil {
 5967|     10|            iseqBuilder.recordAcc(AccRecords(compare: accCompare, prefix: prefix))
 5968|     10|        }
 5969|    345|    }
