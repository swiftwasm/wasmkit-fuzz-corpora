$s9WasmTypes4V128V11descriptionSSvg:
   60|     15|    public var description: String {
   61|     15|        // Build the hex string in a single byte buffer to avoid per-byte
   62|     15|        // string allocations.
   63|     15|        var utf8: [UInt8] = []
   64|     15|        utf8.reserveCapacity(2 + bytes.count * 2)
   65|     15|        utf8.append(UInt8(ascii: "0"))
   66|     15|        utf8.append(UInt8(ascii: "x"))
   67|    240|        for byte in bytes {
   68|    240|            utf8.append(hexDigits.utf8Start[Int(byte >> 4)])
   69|    240|            utf8.append(hexDigits.utf8Start[Int(byte & 0xF)])
   70|    240|        }
   71|     15|        return String(decoding: utf8, as: UTF8.self)
   72|     15|    }
