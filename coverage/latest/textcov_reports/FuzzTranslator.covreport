   97|  1.29k|        private static func commit(_ base: UnsafeMutableRawPointer, offset: Int, byteCount: Int) -> Bool {
   98|       |            #if os(WASI)
   99|       |                // WASI does not support commit-without-reserve; use a full allocation instead
  100|       |                return false
  101|       |            #elseif os(Windows)
  102|       |                return VirtualAlloc(
  103|       |                    base.advanced(by: offset), SIZE_T(byteCount),
  104|       |                    DWORD(MEM_COMMIT), DWORD(PAGE_READWRITE)
  105|       |                ) != nil
  106|       |            #else
  107|  1.29k|                return mprotect(base.advanced(by: offset), byteCount, PROT_READ | PROT_WRITE) == 0
  108|       |            #endif
  109|  1.29k|        }
