   60|     16|    public var description: String {
   61|     16|        // Build the hex string in a single byte buffer to avoid per-byte
   62|     16|        // string allocations.
   63|     16|        var utf8: [UInt8] = []
   64|     16|        utf8.reserveCapacity(2 + bytes.count * 2)
   65|     16|        utf8.append(UInt8(ascii: "0"))
   66|     16|        utf8.append(UInt8(ascii: "x"))
   67|    256|        for byte in bytes {
   68|    256|            utf8.append(hexDigits.utf8Start[Int(byte >> 4)])
   69|    256|            utf8.append(hexDigits.utf8Start[Int(byte & 0xF)])
   70|    256|        }
   71|     16|        return String(decoding: utf8, as: UTF8.self)
   72|     16|    }
