 6078|    498|    mutating func visitI64Eqz() throws(WasmKitError) -> Output {
 6079|    498|        // Captured before `popVRegOperand`, which resets the last emission.
 6080|    498|        let candidate = iseqBuilder.fusableEmission
 6081|    498|        let value = try popVRegOperand(.i64)
 6082|    487|        let result = valueStack.push(.i32)
 6083|    487|        guard let value = value else { return }
 6084|    379|        // An `i64.eqz` of a 64-bit `and` the previous instruction just computed is
 6085|    379|        // that bit test negated, so a following branch can replace both.
 6086|    379|        var fusable: (condition: FusableCondition, result: VReg, start: MetaProgramCounter?)?
 6087|    379|        var prefix: (position: MetaProgramCounter, producer: AccProducerForm)?
 6088|    379|        var accCompare: AccCompare?
 6089|    379|        if let candidate, candidate.result == value, iseqBuilder.canRewind(to: candidate) {
 6090|     10|            fusable = (.negated(candidate.condition), result, candidate.position)
 6091|     10|            prefix = candidate.prefix.map { (candidate.position, $0) }
 6092|     10|            accCompare = candidate.accCompare
 6093|     10|            accCompare?.negated.toggle()
 6094|     10|        }
 6095|    379|        emit(
 6096|    379|            .i64Eqz(Instruction.UnaryOperand(result: LVReg(result), input: LVReg(value))),
 6097|    379|            resultRelink: { newResult in
 6098|    379|                .i64Eqz(Instruction.UnaryOperand(result: LVReg(newResult), input: LVReg(value)))
 6099|    379|            },
 6100|    379|            fusable: fusable
 6101|    379|        )
 6102|    379|        if prefix != nil || accCompare != nil {
 6103|     10|            iseqBuilder.recordAcc(AccRecords(compare: accCompare, prefix: prefix))
 6104|     10|        }
 6105|    379|    }
