   60|     14|    public var description: String {
   61|     14|        // Build the hex string in a single byte buffer to avoid per-byte
   62|     14|        // string allocations.
   63|     14|        var utf8: [UInt8] = []
   64|     14|        utf8.reserveCapacity(2 + bytes.count * 2)
   65|     14|        utf8.append(UInt8(ascii: "0"))
   66|     14|        utf8.append(UInt8(ascii: "x"))
   67|    224|        for byte in bytes {
   68|    224|            utf8.append(hexDigits.utf8Start[Int(byte >> 4)])
   69|    224|            utf8.append(hexDigits.utf8Start[Int(byte & 0xF)])
   70|    224|        }
   71|     14|        return String(decoding: utf8, as: UTF8.self)
   72|     14|    }
