 5957|    469|    mutating func visitI64Eqz() throws(WasmKitError) -> Output {
 5958|    469|        // Captured before `popVRegOperand`, which resets the last emission.
 5959|    469|        let candidate = iseqBuilder.fusableEmission
 5960|    469|        let value = try popVRegOperand(.i64)
 5961|    457|        let result = valueStack.push(.i32)
 5962|    457|        guard let value = value else { return }
 5963|    352|        // An `i64.eqz` of a 64-bit `and` the previous instruction just computed is
 5964|    352|        // that bit test negated, so a following branch can replace both.
 5965|    352|        var fusable: (condition: FusableCondition, result: VReg, start: MetaProgramCounter?)?
 5966|    352|        var prefix: (position: MetaProgramCounter, producer: AccProducerForm)?
 5967|    352|        var accCompare: AccCompare?
 5968|    352|        if let candidate, candidate.result == value, iseqBuilder.canRewind(to: candidate) {
 5969|     10|            fusable = (.negated(candidate.condition), result, candidate.position)
 5970|     10|            prefix = candidate.prefix.map { (candidate.position, $0) }
 5971|     10|            accCompare = candidate.accCompare
 5972|     10|            accCompare?.negated.toggle()
 5973|     10|        }
 5974|    352|        emit(
 5975|    352|            .i64Eqz(Instruction.UnaryOperand(result: LVReg(result), input: LVReg(value))),
 5976|    352|            resultRelink: { newResult in
 5977|    352|                .i64Eqz(Instruction.UnaryOperand(result: LVReg(newResult), input: LVReg(value)))
 5978|    352|            },
 5979|    352|            fusable: fusable
 5980|    352|        )
 5981|    352|        if prefix != nil || accCompare != nil {
 5982|     10|            iseqBuilder.recordAcc(AccRecords(compare: accCompare, prefix: prefix))
 5983|     10|        }
 5984|    352|    }
